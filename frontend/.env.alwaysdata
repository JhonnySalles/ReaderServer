# ==============================================================================
# Diretiva de Configuração do Frontend para Alwaysdata (Produção)
# ==============================================================================

# Caminho base do site no Alwaysdata (ex: elpsyserver.alwaysdata.net/readerserver/)
VITE_BASE_PATH=/readerserver/

# URL base da API do ReaderServer no Alwaysdata
VITE_API_BASE_URL=https://elpsyserver.alwaysdata.net/readerserver/api

# Chave de segurança da API (deve ser a mesma configurada em SECURITY_API_KEY na API)
VITE_API_KEY=53cr37-api-key

# Usuario sugerido para a tela de login
VITE_API_USERNAME=admin
