# Porta em que o frontend ira rodar
PORT=5179

# Apontamento para o servidor da API (ReaderServer)
# Local: http://localhost:8083
# Nuvem Alwaysdata: https://suaconta.alwaysdata.net
VITE_API_BASE_URL=https://suaconta.alwaysdata.net

# Credenciais para autenticação transparente
VITE_API_USERNAME=admin
VITE_API_PASSWORD=admin

# Chave secreta de seguranca da API (registrada na tabela seguranca)
VITE_API_KEY=sua_chave_secreta_aqui
